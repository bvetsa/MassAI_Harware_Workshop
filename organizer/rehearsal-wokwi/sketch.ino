  const size_t scaleBytes = int8 ? 8 : 0;
  if (bytes != header + scaleBytes + (kInputs + 1) * width * stride + 4 * (width + 1)) return NAN;

  const float s1 = int8 ? readFloat(model + header) : 1.0f;
  const float s2 = int8 ? readFloat(model + header + 4) : 1.0f;
