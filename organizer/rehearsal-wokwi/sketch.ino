                  (uint32_t(bytes[2]) << 16) | (uint32_t(bytes[3]) << 24);
  float value;
  memcpy(&value, &bits, sizeof(value));
  return value;
}

inline float readWeight(const uint8_t *bytes, bool int8, float scale) {
  if (!int8) return readFloat(bytes);
